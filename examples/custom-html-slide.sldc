{
  "format": "slideclark",
  "version": 3,
  "meta": { "name": "A custom HTML slide", "theme": "studio" },
  "slides": [
    { "id": "s1", "layout": "title", "headline": "Slides can be real HTML", "subhead": "One template slide, then one written as HTML, CSS and JavaScript" },
    { "id": "s2", "layout": "custom", "headline": "Churn fell to 2.1%",
      "custom": {
        "base": "custom",
        "html": "<main class=\"wrap\"><p class=\"k\">Q3 retention</p><h1>Churn fell to <b id=\"n\">2.1</b>%</h1><div class=\"bars\"><i style=\"--h:90\"></i><i style=\"--h:72\"></i><i style=\"--h:55\"></i><i style=\"--h:38\"></i></div></main>",
        "css": ".wrap{position:absolute;inset:0;padding:90px 110px;background:#0f0d24;color:#fff;font-family:system-ui,sans-serif}.k{margin:0 0 18px;letter-spacing:.14em;text-transform:uppercase;font-size:22px;color:#a79eff}h1{margin:0;font-size:96px;line-height:1;letter-spacing:-.04em}h1 b{color:#7b6cff}.bars{display:flex;align-items:flex-end;gap:28px;height:230px;margin-top:70px}.bars i{flex:1;height:calc(var(--h) * 1%);background:#7b6cff;border-radius:10px 10px 0 0;opacity:.35}.bars i:last-child{opacity:1}",
        "js": "",
        "interactive": false
      }
    }
  ]
}
